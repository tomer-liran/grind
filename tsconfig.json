{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "vite-plugin-pwa/client", "vitest/globals"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "tests/**/*.js",
    "*.config.js",
    "*.config.mjs"
  ]
}
