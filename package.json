{
  "name": "grind",
  "version": "1.0.0",
  "description": "Minimalist fitness PWA for structured, slightly randomized hypertrophy training with slot-style session reveals, session persistence, and PR tracking.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:repo": "node scripts/validate-repository.js",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test:coverage && npm run validate:repo && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomer-liran/grind.git"
  },
  "keywords": [
    "fitness",
    "workout-tracker",
    "pwa",
    "offline-first",
    "vanilla-javascript"
  ],
  "author": "Tomer Liran",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@12.0.1",
  "bugs": {
    "url": "https://github.com/tomer-liran/grind/issues"
  },
  "homepage": "https://github.com/tomer-liran/grind#readme",
  "dependencies": {
    "lucide-static": "^1.59.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.5"
  }
}
